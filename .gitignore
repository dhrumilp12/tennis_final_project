# Local environments and credentials
.venv/
venv/
env/
.env
.env.*
!.env.example

# Python, notebook and operating-system caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
