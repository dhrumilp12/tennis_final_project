dist/

# Pipeline-created local staging directories and retained run backups
.*.staging-*/
.*.previous-*/
*.executed.tmp.ipynb

# Disposable run logs; these three small logs substantiate historical claims
Dhrumil/validation/*.log
!Dhrumil/validation/demo_final.log
!Dhrumil/validation/full_cli.log
!Dhrumil/validation/notebook.log

# Reproducible intermediate runs, not authoritative results or retained evidence
